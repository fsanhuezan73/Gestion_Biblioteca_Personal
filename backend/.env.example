# Oracle Autonomous Database
ORACLE_USER=your_db_user
ORACLE_PASSWORD=your_db_password
ORACLE_DSN=your_service_name_high
ORACLE_WALLET_DIR=/path/to/wallet
ORACLE_WALLET_PASSWORD=your_wallet_password
# Solo para Render: ZIP del wallet codificado en Base64. No usar junto con ORACLE_WALLET_DIR.
ORACLE_WALLET_BASE64=

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Mantener deshabilitado hasta configurar y verificar el correo de recuperación.
PASSWORD_RESET_ENABLED=false
FRONTEND_BASE_URL=http://localhost:5173

# SMTP cifrado: STARTTLS (587) o SSL desde la conexión (465).
# Configure estos valores y pruebe el flujo antes de activar PASSWORD_RESET_ENABLED.
# Para Mailtrap Email Sandbox: SMTP_HOST=sandbox.smtp.mailtrap.io,
# SMTP_PORT=2525, SMTP_SECURITY=starttls. Use las credenciales SMTP
# de la bandeja Sandbox, nunca las del servicio de envío real.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# App
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
