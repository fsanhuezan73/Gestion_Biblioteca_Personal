{
  "name": "Biblioteca Personal Dev",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bullseye",

  // Instala Node.js 18 sobre la imagen base de Python
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "18"
    }
  },

  // Puertos que Codespaces expondrá automáticamente
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": {
      "label": "FastAPI Backend",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Vue Frontend",
      "onAutoForward": "openBrowser"
    }
  },

  // Script que se ejecuta una sola vez al crear el Codespace
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // Extensiones y configuración de VS Code en el Codespace
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "Vue.volar",
        "dbaeumer.vscode-eslint",
        "eamodio.gitlens",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/backend/venv/bin/python",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[python]": {
          "editor.defaultFormatter": "ms-python.python"
        }
      }
    }
  }
}
